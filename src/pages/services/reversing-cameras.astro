---
// src/pages/services/reversing-cameras.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Reversing Camera Installation"
  description="Professional reversing camera installations for enhanced safety and visibility."
>
  <!-- 🚘 Hero Section -->
  <section
    class="relative w-full h-96 bg-cover bg-center text-white flex items-center justify-center"
    style="background-image: url('/services/reversing-camera-hero.jpg');"
  >
    <div class="bg-black bg-opacity-60 p-8 rounded text-center">
      <h1 class="text-4xl md:text-5xl font-bold">Reversing Cameras</h1>
      <p class="mt-2 text-lg">
        Drive with confidence. See exactly what's behind you — every time.
      </p>
    </div>
  </section>

  <!-- 📦 Expandable Info Box -->
  <section class="max-w-5xl mx-auto px-4 py-16">
    <details
      x-data="{ open: false }"
      x-bind:open="open"
      @toggle="open = !open"
      class="border rounded-lg p-6 shadow-md"
    >
      <summary
        class="font-semibold text-lg flex items-center gap-2 cursor-pointer"
      >
        <span class="text-green-600" x-text="open ? '➖' : '➕'"></span>
        Why Install a Reversing Camera?
      </summary>
      <div class="mt-4 text-gray-700">
        <p class="mb-4">
          A <strong>reversing camera</strong> adds critical visibility to the rear
          of your vehicle, helping to:
        </p>
        <ul class="list-disc ml-6 space-y-2">
          <li>Prevent collisions with objects, people, or pets</li>
          <li>Make trailer hitching fast and accurate</li>
          <li>Boost overall reversing confidence and safety</li>
          <li>Enhance rear visibility for large vehicles and vans</li>
        </ul>
        <p class="mt-4">
          We offer both in-dash display integrations and universal rear-view
          mirror monitors.
        </p>
      </div>
    </details>
  </section>

  <!-- 🙌 Why Choose Us -->
  <section class="bg-atb-t-gray py-12 px-4 text-center text-gray-800">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">Why Choose Advanced Towbars?</h2>
      <p>
        Our installers provide clean, professional integrations into your
        vehicle without damaging trims or panels. We use premium waterproof,
        wide-angle HD reversing cameras compatible with most vehicle models —
        including utes, vans, SUVs, and commercial fleets.
      </p>
    </div>
  </section>

  <!-- ☎️ Call-to-Action -->
  <section class="text-center py-10">
    <a
      href="tel:1300238869"
      class="hover:bg-atb-p-blue-dark bg-atb-p-blue text-white text-lg font-semibold px-8 py-4 rounded-full shadow hover:bg-atb-p-dark transition"
    >
      Book Installation – 1300 238 869
    </a>
  </section>

  <!-- 📸 Install Gallery -->
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-center mb-10">
      Recent Reversing Camera Installs
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      <div class="bg-white rounded shadow p-4 flex flex-col items-center">
        <img
          src="/services/tail-gate.jpg"
          alt="tail gate reverse cam"
          class="w-full h-48 object-cover rounded"
        />
        <p class="mt-2 font-semibold">Tailgate Mount Camera</p>
        <a
          href="#"
          class="hover:bg-atb-p-blue-dark mt-2 inline-block text-sm bg-atb-p-blue text-white py-2 px-4 rounded-full"
        >
          View Install
        </a>
      </div>
      <div class="bg-white rounded shadow p-4 flex flex-col items-center">
        <img
          src="/services/rear-roof-mount.jpg"
          alt="rear roof mount reverse camera"
          class="w-full h-48 object-cover rounded"
        />
        <p class="mt-2 font-semibold">Rear Roof Mount Camera</p>
        <a
          href="#"
          class="hover:bg-atb-p-blue-dark mt-2 inline-block text-sm bg-atb-p-blue text-white py-2 px-4 rounded-full"
        >
          View Install
        </a>
      </div>
      <div class="bg-white rounded shadow p-4 flex flex-col items-center">
        <img
          src="/services/mirror-display.jpg"
          alt="Mirror Display"
          class="w-full h-48 object-cover rounded"
        />
        <p class="mt-2 font-semibold">Mirror Display Upgrade</p>
        <a
          href="#"
          class="hover:bg-atb-p-blue-dark mt-2 inline-block text-sm bg-atb-p-blue text-white py-2 px-4 rounded-full"
        >
          View Install
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
