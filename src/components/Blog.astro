---
import type { CollectionEntry } from "astro:content";

export interface Props {
  featured: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { featured, posts } = Astro.props;
---

<section class="w-full bg-atb-t-gray-light py-16">
  <div class="max-w-7xl mx-auto px-4 space-y-12">
    <!-- ✅ Featured Post -->
    <article class="flex flex-col lg:flex-row items-center gap-8 bg-atb-s-white border rounded-lg shadow-sm overflow-hidden p-6">
      <img
        src={featured.data.heroImage}
        alt={featured.data.title}
        class="w-full lg:w-1/2 h-64 md:h-80 object-cover rounded-lg"
      />
      <div class="lg:w-1/2 space-y-4">
        <span class="text-sm font-semibold text-atb-p-blue">
          {featured.data.tag}
        </span>
        <h2 class="text-3xl font-bold text-atb-black-dark">
          {featured.data.title}
        </h2>
        <p class="text-atb-black-light">{featured.data.description}</p>
        <a
          href={`/blog/${featured.slug}`}
          class="inline-block mt-4 text-atb-p-blue underline hover:text-atb-p-dark transition"
        >
          Read More →
        </a>
      </div>
    </article>

    <!-- ✅ Recent Posts Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        posts.map((post) => (
          <article class="bg-atb-s-white border rounded-lg shadow-sm overflow-hidden flex flex-col">
            <img
              src={post.data.heroImage}
              alt={post.data.title}
              class="w-full h-48 object-cover"
            />
            <div class="p-4 space-y-2 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-xs font-medium text-atb-p-blue">
                  {post.data.tag}
                </span>
                <h3 class="text-lg font-semibold mt-1">{post.data.title}</h3>
                <p class="text-sm text-gray-600">{post.data.description}</p>
              </div>
              <a
                href={`/blog/${post.slug}`}
                class="text-atb-p-blue text-sm underline hover:text-atb-p-dark mt-4 inline-block"
              >
                Read More →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
