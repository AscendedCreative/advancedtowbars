---
export interface Service {
  title: string;
  image: string;
  link: string;
}

export interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

<section class="w-full bg-atb-t-white py-16">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {
        services.map((service) => (
          <a
            href={service.link}
            class="group block rounded-lg overflow-hidden border hover:shadow-lg transition"
          >
            <img
              src={service.image}
              alt={service.title}
              class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <div class="p-4 bg-white">
              <h3 class="text-lg font-semibold text-atb-black-dark group-hover:text-atb-p-blue transition">
                {service.title}
              </h3>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
