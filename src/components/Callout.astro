---
const {
  headline = "Default Headline",
  bg = "bg-atb-p-blue",
  image = "/img/callout-bg.png", // Make sure this image is in /public/img/
} = Astro.props;
---

<section class={`relative w-full overflow-hidden ${bg}`}>
  <!-- ✅ Image Overlay on top of the background -->
  {
    image && (
      <img
        src={image}
        alt="Callout overlay"
        class="absolute inset-0 w-full h-full object-cover opacity-30 z-10 mix-blend-overlay pointer-events-none"
        aria-hidden="true"
      />
    )
  }

  <!-- ✅ Text Content (above everything) -->
  <div
    class="relative z-20 text-center py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto"
  >
    <h1 class="mt-4 text-4xl md:text-5xl font-bold text-atb-s-white">
      {headline}
    </h1>
  </div>
</section>
