---
// src/pages/services/truck-bar-fitting.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Truck Bar Fitting"
  description="Heavy-duty truck bar installation services for added protection and functionality."
>
  <!-- 🚚 Hero Section -->
  <section
    class="relative w-full h-96 bg-cover bg-center text-white flex items-center justify-center"
    style="background-image: url('/services/truck-bar-hero.jpeg');"
  >
    <div class="bg-black bg-opacity-60 p-8 rounded text-center">
      <h1 class="text-4xl md:text-5xl font-bold">Truck Bar Fitting</h1>
      <p class="mt-2 text-lg">
        Reinforce your truck with strong, compliant bar systems tailored for
        work and safety.
      </p>
    </div>
  </section>

  <!-- 📦 Expandable Info Section -->
  <section class="max-w-5xl mx-auto px-4 py-16">
    <details
      x-data="{ open: false }"
      x-bind:open="open"
      @toggle="open = !open"
      class="border rounded-lg p-6 shadow-md"
    >
      <summary
        class="font-semibold text-lg flex items-center gap-2 cursor-pointer"
      >
        <span class="text-green-600" x-text="open ? '➖' : '➕'"></span>
        What Types of Truck Bars Do We Fit?
      </summary>
      <div class="mt-4 text-gray-700">
        <p class="mb-4">Our range of truck bar fittings include:</p>
        <ul class="list-disc ml-6 space-y-2">
          <li>Rear underrun bars (ADR compliant)</li>
          <li>Heavy-duty step bars</li>
          <li>Towbars with integrated pintle hooks</li>
          <li>Custom fabricated tow plates</li>
          <li>Adjustable drop hitches for fleets</li>
          <li>Electric trailer brake interface integration</li>
        </ul>
        <p class="mt-4">
          All fittings are performed to manufacturer standards and ADR
          regulations, giving you peace of mind and full compliance.
        </p>
      </div>
    </details>
  </section>

  <!-- 🙌 Why Truck Owners Choose Us -->
  <section class="bg-atb-t-gray py-12 px-4 text-center text-gray-800">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">Why Truck Owners Choose Us</h2>
      <p>
        Our experienced technicians specialize in fitting truck bars for
        commercial, fleet, and worksite vehicles. Whether you're operating utes,
        cab chassis, or box trucks, we ensure your gear meets industry safety
        standards and lasts the distance.
      </p>
    </div>
  </section>

  <!-- 📞 Call to Action -->
  <section class="text-center py-10">
    <a
      href="tel:1300238869"
      class="hover:bg-atb-p-blue-dark bg-atb-p-blue text-white text-lg font-semibold px-8 py-4 rounded-full shadow hover:bg-atb-p-dark transition"
    >
      Book Your Truck Bar Fitting – 1300 238 869
    </a>
  </section>

  <!-- 🧰 Our Work Gallery -->
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-center mb-10">Our Work</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      <div class="bg-white rounded shadow p-4 flex flex-col items-center">
        <img
          src="/services/cab-chassis.jpg"
          alt="Truck Bar Fitting on Cab Chassis"
          class="w-full h-48 object-cover rounded"
        />
        <p class="mt-2 font-semibold">
          Cab Chassis Rear Step Bar with Tow Plate
        </p>
      </div>
      <div class="bg-white rounded shadow p-4 flex flex-col items-center">
        <img
          src="/services/truck-bar-2.jpg"
          alt="Fleet truck bar installation"
          class="w-full h-48 object-cover rounded"
        />
        <p class="mt-2 font-semibold">Fleet Truck – ADR Compliant Rear Bar</p>
      </div>
      <div class="bg-white rounded shadow p-4 flex flex-col items-center">
        <img
          src="/services/truck-bar-3.jpg"
          alt="Custom bar for towing trailer"
          class="w-full h-48 object-cover rounded"
        />
        <p class="mt-2 font-semibold">Heavy-Duty Pintle Hook Towbar</p>
      </div>
    </div>
  </section>
</BaseLayout>
