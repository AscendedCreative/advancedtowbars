---
// BrandCarousel.astro
export interface Brand {
  name: string;
  logo: string; // Should point to /brands/your-logo.svg
}

export interface Props {
  brands: Brand[];
}

const { brands } = Astro.props;
---

<section
  class="w-full bg-atb-t-white py-12 overflow-hidden"
>
  <div class="relative whitespace-nowrap">
    <div class="inline-flex gap-12 animate-scroll-slow">
      {
        brands.concat(brands).map((brand) => (
          <div class="flex-shrink-0 w-32 h-20 flex items-center justify-center">
            <img
              src={brand.logo}
              alt={brand.name}
              class="max-h-full max-w-full object-contain"
              loading="lazy"
              onerror="this.src='/img/hero-placeholder.jpg'"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes scroll-slow {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-scroll-slow {
    animation: scroll-slow 40s linear infinite;
  }
</style>
