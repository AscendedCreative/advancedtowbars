---
const {
  title = "Advanced Towbars Melbourne | The Towbar Installation Experts, We Come To You",
  description = "Melbourne’s trusted towbar installation specialists. Advanced Towbars offers expert towbar fitting, electric brake controllers, towing accessories & more for all vehicle types. Get a free quote today.",
  image = "/images/og-image.jpg",
  url = import.meta.env.SITE || "https://www.advancedtowbars.com.au",
} = Astro.props;

const ogImage = new URL(
  image,
  import.meta.env.SITE || "https://www.advancedtowbars.com.au"
).toString();
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />

  <!-- ✅ Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- ✅ Open Graph (Facebook, LinkedIn) -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={url} />

  <!-- ✅ Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- ✅ Preload OG image -->
  <link rel="preload" href={ogImage} as="image" />

  <!-- Custom additions per page (e.g. structured data, extra styles, etc.) -->
  <slot name="head" />
</head>
