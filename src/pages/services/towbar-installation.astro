---
// src/pages/services/towbar-installation.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Towbar Installation"
  description="Expert towbar installation services for all vehicle types."
>
  <!-- 🚘 Hero Section -->
  <section
    class="relative w-full h-96 bg-cover bg-center text-white flex items-center justify-center"
    style="background-image: url('/services/towbar-hero.avif');"
  >
    <div class="bg-black bg-opacity-60 p-8 rounded">
      <h1 class="text-4xl md:text-5xl font-bold">Towbar Installation</h1>
      <p class="mt-2 text-lg">
        Precision fitting, safety, and convenience for every vehicle
      </p>
    </div>
  </section>

  <!-- 📦 Expandable Box Section -->
  <section class="max-w-5xl mx-auto px-4 py-16">
    <details
      x-data="{ open: false }"
      x-bind:open="open"
      @toggle="open = !open"
      class="border rounded-lg p-6 shadow-md"
    >
      <summary
        class="font-semibold text-lg flex items-center gap-2 cursor-pointer"
      >
        <span class="text-green-600" x-text="open ? '➖' : '➕'"></span>
        Factory Coded Wiring Solutions
      </summary>
      <div class="mt-4 text-gray-700">
        <p class="mb-4">
          Using <strong>factory coded wiring solutions</strong> and the latest
          <strong>software</strong>, you benefit from integrated safety features
          like:
        </p>
        <ul class="list-disc ml-6 space-y-2">
          <li>Stability control</li>
          <li>Reverse camera</li>
          <li>City braking</li>
          <li>Lane change warning</li>
          <li>Seatbelt pre-tensioning systems</li>
          <li>Reverse sensors</li>
          <li>Electric rear tail gate</li>
          <li>Active rear suspension systems</li>
        </ul>
        <p class="mt-4">
          These systems adjust or deactivate automatically during towing for
          optimal performance.
        </p>
      </div>
    </details>
  </section>

  <!-- 🙌 Why Choose Us -->
  <section class="bg-atb-t-gray py-12 px-4 text-center text-gray-800">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">Why Choose Us?</h2>
      <p>
        Our certified fitters provide professional on-site installation,
        tailored to your vehicle make and model. We're one of the few providers
        in Victoria offering both product and fitting in a single visit. Our
        lifetime warranty and fast turnaround times ensure peace of mind and
        convenience.
      </p>
    </div>
  </section>

  <!-- 📞 CTA -->
  <section class="text-center py-10">
    <a
      href="tel:1300238869"
      class="hover:bg-atb-p-blue-dark bg-atb-p-blue text-white text-lg font-semibold px-8 py-4 rounded-full shadow hover:bg-atb-p-dark transition"
    >
      Call Now to Book – 1300 238 869
    </a>
  </section>

  <!-- 🧰 Our Work Gallery -->
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-center mb-10">Our Work</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      <div class="bg-white rounded shadow p-4 flex flex-col items-center">
        <img
          src="/services/(11-2022)-BMW-3-SERIES-TOURING-WAGON-BACK-(AP).png"
          alt="2022 BMW 3 Series Touring Wagon"
          class="w-full h-48 object-cover rounded"
        />
        <p class="mt-2 font-semibold">2022 BMW 3 Series Touring Wagon – Euro Bar</p>
        <a
          href="#"
          class="hover:bg-atb-p-blue-dark mt-2 inline-block text-sm bg-atb-p-blue text-white py-2 px-4 rounded-full"
          >View this product</a
        >
      </div>
      <div class="bg-white rounded shadow p-4 flex flex-col items-center">
        <img
          src="/services/(03-2019)-BMW-X5-G05-(NOT-ADBLUE)-BACK-(AP).png"
          alt="2019 BMW X5 G05"
          class="w-full h-48 object-cover rounded"
        />
        <p class="mt-2 font-semibold">2019 BMW X5 G05 – Heavy Duty Bar</p>
        <a
          href="#"
          class="hover:bg-atb-p-blue-dark mt-2 inline-block text-sm bg-atb-p-blue text-white py-2 px-4 rounded-full"
          >View this product</a
        >
      </div>
      <div class="bg-white rounded shadow p-4 flex flex-col items-center">
        <img
          src="/services/(06-2022)-BMW-X1-F48-LCI-PETROL-BOTTOM-RIGHT-(AP).png"
          alt="2022 BMW X1 F48 LCI"
          class="w-full h-48 object-cover rounded"
        />
        <p class="mt-2 font-semibold">2022 BMW X1 F48 LCI – Euro bar</p>
        <a
          href="#"
          class="hover:bg-atb-p-blue-dark mt-2 inline-block text-sm bg-atb-p-blue text-white py-2 px-4 rounded-full"
          >View this product</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
